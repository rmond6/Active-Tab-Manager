[
	{
		"type": "text",
		"label": "Active Tab Manager (v1.0)",
		"margin": "8px 4px",
		"size": "1.2em"
	},
	{
		"type": "separator",
		"label": "🔳 Tab outline",
		"margin": "14px 0"
	},
	{
		"type": "checkbox",
		"property": "active_tab_manager.outline_enabled",
		"label": "Enable",
		"defaultValue": false
	},
	{
		"type": "string",
		"property": "active_tab_manager.outline_thickness",
		"label": "Thickness (px)",
		"defaultValue": "1",
		"placeholder": "1"
	},
	{
		"type": "string",
		"property": "active_tab_manager.outline_colour",
		"label": "Colour (hex)",
		"defaultValue": "#575757",
		"placeholder": "#575757"
	},
	{
		"type": "string",
		"property": "active_tab_manager.outline_opacity",
		"label": "Opacity (1 to 100)",
		"defaultValue": "100",
		"placeholder": "100"
	},
	{
		"type": "separator",
		"label": "🟧 Tab colour",
		"margin": "14px 0"
	},
	{
		"type": "checkbox",
		"property": "active_tab_manager.tab_enabled",
		"label": "Enable",
		"defaultValue": false
	},
	{
		"type": "string",
		"property": "active_tab_manager.tab_colour",
		"label": "Colour (hex)",
		"defaultValue": "#000000",
		"placeholder": "#000000"
	},
	{
		"type": "string",
		"property": "active_tab_manager.tab_opacity",
		"label": "Opacity (1 to 100)",
		"defaultValue": "100",
		"placeholder": "100"
	},
	{
		"type": "dropdown",
		"property": "active_tab_manager.gradient",
		"label": "Gradient",
		"defaultValue": "none",
		"options": [
			{ "label": "None", "value": "none" },
			{ "label": "Horizontal", "value": "horizontal" },
			{ "label": "Vertical", "value": "vertical" }
		]
	},
	{
		"type": "string",
		"property": "active_tab_manager.grad_start_colour",
		"label": "Start colour (hex)",
		"defaultValue": "#000000",
		"placeholder": "#000000"
	},
	{
		"type": "string",
		"property": "active_tab_manager.grad_start_opacity",
		"label": "Start colour opacity (1 to 100)",
		"defaultValue": "30",
		"placeholder": "30"
	},
	{
		"type": "string",
		"property": "active_tab_manager.grad_end_colour",
		"label": "End colour (hex)",
		"defaultValue": "#646464",
		"placeholder": "#646464"
	},
	{
		"type": "string",
		"property": "active_tab_manager.grad_end_opacity",
		"label": "End colour opacity (1 to 100)",
		"defaultValue": "30",
		"placeholder": "30"
	},
	{
		"type": "checkbox",
		"property": "active_tab_manager.tab_use_theme",
		"label": "Theme colour (your theme colour will be the base colour)",
		"defaultValue": false
	},
	{
		"type": "separator",
		"label": "🟠 Tab corner radius",
		"margin": "14px 0"
	},
	{
		"type": "checkbox",
		"property": "active_tab_manager.radius_enabled",
		"label": "Enable",
		"defaultValue": false
	},
	{
		"type": "string",
		"property": "active_tab_manager.radius",
		"label": "Radius (0 to 20 px)",
		"defaultValue": "8",
		"placeholder": "8"
	},
	{
		"type": "separator",
		"label": "➕ BONUS",
		"margin": "14px 0"
	},
	{
		"type": "checkbox",
		"property": "active_tab_manager.pinned_enabled",
		"label": "Enable pinned tab background",
		"defaultValue": false
	},
	{
		"type": "string",
		"property": "active_tab_manager.pinned_colour",
		"label": "Colour (hex)",
		"defaultValue": "#FFFFFF",
		"placeholder": "#FFFFFF"
	},
	{
		"type": "string",
		"property": "active_tab_manager.pinned_opacity",
		"label": "Opacity (1 to 100)",
		"defaultValue": "10",
		"placeholder": "10"
	},
	{
		"type": "checkbox",
		"property": "active_tab_manager.essential_enabled",
		"label": "Enable essential tab background",
		"defaultValue": false
	},
	{
		"type": "string",
		"property": "active_tab_manager.essential_colour",
		"label": "Colour (hex)",
		"defaultValue": "#FFFFFF",
		"placeholder": "#FFFFFF"
	},
	{
		"type": "string",
		"property": "active_tab_manager.essential_opacity",
		"label": "Opacity (1 to 100)",
		"defaultValue": "10",
		"placeholder": "10"
	}
]